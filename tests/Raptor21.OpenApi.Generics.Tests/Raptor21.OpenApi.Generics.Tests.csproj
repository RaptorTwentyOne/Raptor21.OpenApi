<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Raptor21.OpenApi.Generics.Tests</RootNamespace>
        <AssemblyName>Raptor21.OpenApi.Generics.Tests</AssemblyName>
        <IsPackable>false</IsPackable>
        <!-- SnapshotTester locates Fixtures/ and Snapshots/ through [CallerFilePath]. A CI build maps source
             paths to /_/ (deterministic source paths for Source Link), which would turn that into a path that
             exists nowhere; the test assembly is never shipped, so real paths cost nothing here. -->
        <DeterministicSourcePaths>false</DeterministicSourcePaths>
        <IsPublishable>false</IsPublishable>
        <!-- The generated-output snapshots are committed as plain text and compared verbatim; nothing here is
             shipped, so documentation and warnings-as-errors would only add noise. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Raptor21.OpenApi.Generics.CodeGen\Raptor21.OpenApi.Generics.CodeGen.csproj" />
    </ItemGroup>

    <!-- Fixtures (input OpenAPI documents) and snapshots (.expected) are located in the source tree at run time
         via [CallerFilePath] (see SnapshotTester), not copied to the output directory: a create-on-missing or
         an UPDATE_SNAPSHOTS run must write back to the committed files, not to a throwaway copy under bin. They
         are listed here only so the IDE shows them. -->
    <ItemGroup>
        <None Include="Fixtures\**\*" />
        <None Include="Snapshots\**\*" />
    </ItemGroup>

</Project>
